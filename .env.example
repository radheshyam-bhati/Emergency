# Runtime
NODE_ENV=development
API_PORT=3001

# Required: 32+ random characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# SQLite path. Use an absolute path in production and a temp path in tests.
DATABASE_PATH=server/data/rapid-rescue.db

# Comma-separated allowed origins. Do not use "*" in production.
CORS_ORIGINS=http://localhost:8080

# Set to "true" only if the API is behind a trusted reverse proxy.
TRUST_PROXY=false

# Local development only. Never enable in production.
SEED_DEMO_DATA=true

# Demo accounts created only when SEED_DEMO_DATA=true.
# Change these before running `npm run db:seed`; do not publish them.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password
DEMO_DISPATCHER_EMAIL=dispatcher@example.com
DEMO_DISPATCHER_PASSWORD=replace-with-a-local-demo-password

# Frontend: leave empty for same-origin /api, or set a full API URL.
VITE_API_URL=
